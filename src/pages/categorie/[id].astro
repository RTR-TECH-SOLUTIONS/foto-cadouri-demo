---
import Layout from '../../layouts/Layout.astro';
import ProductsBrowser from '../../components/ProductsBrowser.tsx';
import { categories, products } from '../../data/catalog';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { id: c.id }, props: { c } }));
}
const { c } = Astro.props as { c: (typeof categories)[number] };
const n = products.filter((p) => p.category === c.id).length;
const others = categories.filter((x) => x.id !== c.id);
---
<Layout title={c.name} active={c.id}>
  <section class="wrap pt-8">
    <nav class="text-sm text-muted" aria-label="Breadcrumb"><a href="/" class="hover:text-ink">Acasă</a> / <a href="/cadouri" class="hover:text-ink">Cadouri</a> / <span class="text-ink">{c.name}</span></nav>
    <div class="mt-5 grid items-center gap-6 overflow-hidden rounded-[12px] bg-cream sm:grid-cols-[1fr_260px] lg:grid-cols-[1fr_340px]">
      <div class="px-6 py-8 sm:px-10">
        <p class="eyebrow">{n} {n === 1 ? 'produs' : 'produse'} pe raft</p>
        <h1 class="h-sec mt-3">{c.name}</h1>
        <p class="mt-3 max-w-lg text-[1.02rem] leading-[1.7] text-muted">{c.blurb}. Le ridici din magazin în aceeași zi sau ți le trimitem prin curier.</p>
      </div>
      <img src={c.image} alt="" width="600" height="600" class="hidden h-[220px] w-full object-contain p-4 sm:block lg:h-[260px]" />
    </div>
    <div class="-mx-5 mt-5 flex gap-2 overflow-x-auto px-5 pb-1 sm:mx-0 sm:flex-wrap sm:px-0">
      {others.map((o) => <a href={`/categorie/${o.id}`} class="flex h-10 shrink-0 items-center rounded-lg border border-line bg-white px-4 text-sm font-semibold text-ink hover:border-accent-soft">{o.name}</a>)}
      <a href="/cadouri" class="flex h-10 shrink-0 items-center rounded-lg border border-line bg-white px-4 text-sm font-semibold text-accent hover:border-accent-soft">Toate cadourile</a>
    </div>
  </section>
  <section class="wrap mt-8">
    <ProductsBrowser client:load initialCat={c.id} lockCat />
  </section>
</Layout>
