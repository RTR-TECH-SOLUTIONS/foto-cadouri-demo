---
interface Props {
  name: 'search' | 'user' | 'phone' | 'pin' | 'clock' | 'truck' | 'store' | 'gift' | 'pen' | 'camera' | 'star' | 'chevron' | 'arrow' | 'wa' | 'menu' | 'check';
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls = '' } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class={cls} aria-hidden="true">
  {name === 'search' && <><circle cx="11" cy="11" r="7" /><path d="m20 20-3.6-3.6" /></>}
  {name === 'user' && <><circle cx="12" cy="8.5" r="3.8" /><path d="M4.5 20c1.4-3.6 4.2-5.3 7.5-5.3s6.1 1.7 7.5 5.3" /></>}
  {name === 'phone' && <path d="M5 4h3.2l1.6 4-2 1.3a11 11 0 0 0 4.9 4.9l1.3-2 4 1.6V17a2 2 0 0 1-2.2 2A15.5 15.5 0 0 1 3 6.2 2 2 0 0 1 5 4Z" />}
  {name === 'pin' && <><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.3" /></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></>}
  {name === 'truck' && <><path d="M3 6.5h11v9H3zM14 9.5h3.8l3.2 3.4v2.6h-7" /><circle cx="7" cy="17.5" r="1.8" /><circle cx="17.5" cy="17.5" r="1.8" /></>}
  {name === 'store' && <><path d="M4 9.5 5.5 4h13L20 9.5" /><path d="M4 9.5a2.7 2.7 0 0 0 5.3 0 2.7 2.7 0 0 0 5.4 0 2.7 2.7 0 0 0 5.3 0" /><path d="M5.5 11.5V20h13v-8.5M10 20v-5h4v5" /></>}
  {name === 'gift' && <><rect x="3.5" y="8.5" width="17" height="4" rx="1" /><path d="M5 12.5V20h14v-7.5M12 8.5V20M12 8.5S10.8 4 8.3 4.3C6 4.6 6.6 8.5 12 8.5Zm0 0s1.2-4.5 3.7-4.2c2.3.3 1.7 4.2-3.7 4.2Z" /></>}
  {name === 'pen' && <path d="m4 20 4.2-1 10.6-10.6a2.1 2.1 0 0 0-3-3L5.2 16 4 20Z" />}
  {name === 'camera' && <><path d="M4 8h3.2L9 5.5h6L16.8 8H20v11H4z" /><circle cx="12" cy="13.3" r="3.4" /></>}
  {name === 'star' && <path d="m12 3.8 2.5 5.1 5.6.8-4 4 .9 5.6-5-2.7-5 2.7.9-5.6-4-4 5.6-.8L12 3.8Z" fill="currentColor" stroke="none" />}
  {name === 'chevron' && <path d="m6 9 6 6 6-6" />}
  {name === 'arrow' && <path d="M5 12h14m-5-5 5 5-5 5" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'check' && <path d="m5 12.5 4.2 4.2L19 7" />}
  {name === 'wa' && <path fill="currentColor" stroke="none" d="M12 2.8a9.2 9.2 0 0 0-7.9 13.9L3 21l4.4-1.1A9.2 9.2 0 1 0 12 2.8Zm0 16.7a7.5 7.5 0 0 1-3.9-1.1l-.3-.2-2.6.7.7-2.5-.2-.3A7.5 7.5 0 1 1 12 19.5Zm4.1-5.6c-.2-.1-1.3-.7-1.5-.7-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.1 6.1 0 0 1-3-2.6c-.2-.4.2-.4.6-1.2.1-.1 0-.3 0-.4l-.7-1.6c-.2-.4-.4-.4-.5-.4h-.5a.9.9 0 0 0-.6.3 2.7 2.7 0 0 0-.8 2c0 1.2.8 2.3 1 2.5.1.2 1.7 2.6 4.1 3.6 1.5.7 2.1.7 2.9.6.5-.1 1.3-.6 1.5-1.1.2-.5.2-1 .1-1.1l-.4-.3Z" />}
