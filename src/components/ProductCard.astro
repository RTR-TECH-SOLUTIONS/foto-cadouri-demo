---
import type { Product } from '../data/catalog';
import { discount } from '../data/catalog';

interface Props {
  p: Product;
  eager?: boolean;
}
const { p, eager = false } = Astro.props;
const fmt = (n: number) => `${n.toLocaleString('ro-RO', { minimumFractionDigits: 2 })} lei`;
const off = discount(p);
---
<article class="group relative flex flex-col" data-card={p.slug}>
  <a href={`/produs/${p.slug}`} class="relative block overflow-hidden rounded-[10px] bg-photo">
    <img
      src={p.image}
      alt={p.name}
      width="600"
      height="600"
      loading={eager ? 'eager' : 'lazy'}
      class="aspect-square w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03]"
    />
    <span class="absolute left-3 top-3 rounded-md bg-white/95 px-2 py-1 text-xs font-semibold text-ink shadow-sm" data-off={p.slug} data-badge={p.badge} hidden={!p.badge && off <= 0}>
      {off > 0 ? `-${off}%` : p.badge}
    </span>
    {p.engravable && (
      <span class="absolute bottom-3 left-3 rounded-md bg-ink/85 px-2 py-1 text-xs font-medium text-white">Se poate grava</span>
    )}
  </a>
  <h3 class="mt-3 line-clamp-2 min-h-[2.8em] text-[15px] font-semibold leading-snug text-ink-2">
    <a href={`/produs/${p.slug}`} class="hover:underline">{p.name}</a>
  </h3>
  <div class="mt-2 flex items-center justify-between gap-2">
    <p class="leading-tight">
      <b class="text-[16px] text-ink-2" data-now={p.slug}>{fmt(p.price)}</b>
      <s class="ml-1.5 text-sm text-muted" data-old={p.slug} hidden={!p.oldPrice}>{p.oldPrice ? fmt(p.oldPrice) : ''}</s>
    </p>
    <button
      type="button"
      class="grid size-10 shrink-0 place-items-center rounded-full bg-accent text-white shadow-[0_4px_12px_-4px_rgb(118_86_40/0.6)] transition-colors duration-150 hover:bg-accent-dark"
      aria-label={`Adaugă în coș: ${p.name}`}
      data-add
      data-slug={p.slug}
      data-name={p.name}
      data-price={p.price}
      data-image={p.image}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
    </button>
  </div>
</article>
